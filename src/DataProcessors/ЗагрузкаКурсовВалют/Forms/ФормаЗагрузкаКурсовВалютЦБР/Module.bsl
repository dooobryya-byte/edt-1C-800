
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Объект.ДатаНач = ПолучитьТекущуюДату();
	Объект.ДатаКон = Объект.ДатаНач;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПриИзменении(Элемент)
	Если Объект.ДатаКон < Объект.ДатаНач Тогда
		Объект.ДатаКон=Объект.ДатаНач;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДатаКонПриИзменении(Элемент)
	ТекущаяДатаСервер = ПолучитьТекущуюДату();
	Если Объект.ДатаКон > ТекущаяДатаСервер Тогда
		Объект.ДатаКон = ТекущаяДатаСервер;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьКурсы(Команда)
	
	ЗагрузитьКурсыНаСервере();
	
	Обработчик = Новый ОписаниеОповещения("ПослеВопросаОткрытьРегистр", ЭтотОбъект);
	
	РаботаСДокументамиКлиент.ЗадатьПроизвольныйВопросПользователю(
		"Открыть регистр ""Курсы валют""?",
		,
		Обработчик);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборПериода(Команда)
	
	ПараметрыВыбора = Новый Структура;
	ПараметрыВыбора.Вставить("НачалоПериода", Объект.ДатаНач);
	ПараметрыВыбора.Вставить("КонецПериода", Объект.ДатаКон);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьПериодЗавершение", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ВыборПериода", ПараметрыВыбора, Элементы.ВыборПериода, , , , ОписаниеОповещения);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьТекущуюДату()
	
	Возврат ТекущаяДатаСеанса();
	
КонецФункции

&НаСервере
Процедура ЗагрузитьКурсыНаСервере()
	// Проверка заполнения дат
	Если Не ЗначениеЗаполнено(Объект.ДатаНач) Тогда
	    ВывестиСообщениеПользователю("Не указана Дата начала!");
	    Возврат;
	ИначеЕсли Не ЗначениеЗаполнено(Объект.ДатаКон) Тогда
	    ВывестиСообщениеПользователю("Не указана Дата окончания!");
	    Возврат;
	ИначеЕсли Объект.ДатаНач > Объект.ДатаКон Тогда
	    ВывестиСообщениеПользователю("Неверный диапазон дат!");
	    Возврат;
	ИначеЕсли Объект.ДатаКон > ТекущаяДатаСеанса() Тогда
	    ВывестиСообщениеПользователю("Обратите внимание! Дата окончания больше текущей");
	КонецЕсли;

	ТекущаяДата = Объект.ДатаНач;
	КолНовыхЗаписей = 0;
    КолОбнЗаписей = 0;

	// Код выбранной валюты получаем один раз, чтобы не читать объект в цикле
	КодВалюты = "";
	Если ЗначениеЗаполнено(Объект.Валюта) Тогда
		ЗапросКода = Новый Запрос(
			"ВЫБРАТЬ
			|	Валюты.Код КАК Код
			|ИЗ
			|	Справочник.Валюты КАК Валюты
			|ГДЕ
			|	Валюты.Ссылка = &Ссылка");
		ЗапросКода.УстановитьПараметр("Ссылка", Объект.Валюта);
		ВыборкаКода = ЗапросКода.Выполнить().Выбрать();
		Если ВыборкаКода.Следующий() Тогда
			КодВалюты = Строка(ВыборкаКода.Код);
		КонецЕсли;
	КонецЕсли;

	// HTTP-соединение создаём один раз до цикла
	Защита = Новый ЗащищенноеСоединениеOpenSSL();
	Соединение = Новый HTTPСоединение("www.cbr.ru", 443,,,,, Защита);

	Пока ТекущаяДата <= Объект.ДатаКон Цикл

	    // 1. Запрос к ЦБ
	    АдресРесурса = "/scripts/XML_daily.asp?date_req=" + Формат(ТекущаяДата, "ДФ=dd/MM/yyyy");
	    Запрос = Новый HTTPЗапрос(АдресРесурса);

	    Попытка
	        Ответ = Соединение.Получить(Запрос);
	    Исключение
	        ВывестиСообщениеПользователю("Ошибка подключения к серверу ЦБ: " + ОписаниеОшибки());
	        Возврат;
	    КонецПопытки;

	    Если Ответ.КодСостояния <> 200 Тогда
	        ВывестиСообщениеПользователю("Ошибка сервера: " + Ответ.КодСостояния);
	        ТекущаяДата = ТекущаяДата + 86400;
	        Продолжить;
	    КонецЕсли;

	    // 2. Парсинг XML — собираем все курсы за день в соответствие
	    ЧтениеXML = Новый ЧтениеXML;
	    ЧтениеXML.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());

	    // Проверка даты в ValCurs
	    ДатаИзXML = '00010101';
	    Пока ЧтениеXML.Прочитать() Цикл
	        Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "ValCurs" Тогда
	            ДатаСтрока = ЧтениеXML.ПолучитьАтрибут("Date");
	            Если ЗначениеЗаполнено(ДатаСтрока) Тогда
					ДатаИзXML = РаботаСДокументамиСервер.СтрокаВДату(ДатаСтрока);
	            КонецЕсли;
	            Прервать; // выходим, атрибут прочитан
	        КонецЕсли;
	    КонецЦикла;

	    // Если дата из XML не совпадает с запрошенной — пропускаем
	    Если ДатаИзXML <> ТекущаяДата Тогда
	        ЧтениеXML.Закрыть();
	        ТекущаяДата = ТекущаяДата + 86400;  // Добавляем день к текущей дате
	        Продолжить;
	    КонецЕсли;

		
	    КурсыЗаДень = Новый Соответствие; // Ключ: СсылкаВалюта, Значение: Структура(Курс, Кратность)

	    Пока ЧтениеXML.Прочитать() Цикл

	        Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "Valute" Тогда

	            ТекКод = "";
	            ТекКурс = 0;
	            ТекНоминал = 1;

	            Пока ЧтениеXML.Прочитать() Цикл
	                Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента И ЧтениеXML.Имя = "Valute" Тогда
	                    Прервать;
	                КонецЕсли;

	                Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
	                    ИмяУзла = ЧтениеXML.Имя;
	                    ЧтениеXML.Прочитать();

	                    Если ИмяУзла = "NumCode" Тогда
	                        ТекКод = ЧтениеXML.Значение;
	                    ИначеЕсли ИмяУзла = "Nominal" Тогда
	                        ТекНоминал = Число(СтрЗаменить(ЧтениеXML.Значение, ",", "."));
	                    ИначеЕсли ИмяУзла = "Value" Тогда
	                        ТекКурс = Число(СтрЗаменить(ЧтениеXML.Значение, ",", "."));
	                    КонецЕсли;
	                КонецЕсли;
	            КонецЦикла;

	            // 3. Фильтр по валюте и поиск ссылки
	            Если ЗначениеЗаполнено(ТекКод) Тогда
	                Если (Не ЗначениеЗаполнено(Объект.Валюта)) Или (КодВалюты = ТекКод) Тогда
	                    СсылкаВалюта = Справочники.Валюты.НайтиПоКоду(ТекКод);
	                    Если Не СсылкаВалюта.Пустая() Тогда
	                        КурсыЗаДень.Вставить(СсылкаВалюта, Новый Структура("Курс, Кратность", ТекКурс, ТекНоминал));
	                    КонецЕсли;
	                КонецЕсли;
	            КонецЕсли;

	        КонецЕсли;
	    КонецЦикла;

	    ЧтениеXML.Закрыть();

	    // 4. Запись в регистр через НаборЗаписей — один набор на валюту
	    Для Каждого ЭлементКурса Из КурсыЗаДень Цикл
	        СсылкаВалюта = ЭлементКурса.Ключ;
	        ДанныеКурса = ЭлементКурса.Значение;

	        НаборЗаписей = РегистрыСведений.КурсыВалют.СоздатьНаборЗаписей();
	        НаборЗаписей.Отбор.Валюта.Установить(СсылкаВалюта);
	        НаборЗаписей.Прочитать();

	        // Ищем запись за текущую дату
	        ЗаписьНайдена = Ложь;
	        Для Каждого Запись Из НаборЗаписей Цикл
	            Если Запись.Период = ТекущаяДата Тогда
	                Запись.Курс = ДанныеКурса.Курс;
	                Запись.Кратность = ДанныеКурса.Кратность;
	                ЗаписьНайдена = Истина;
					КолОбнЗаписей = КолОбнЗаписей + 1;
	                Прервать;
	            КонецЕсли;
	        КонецЦикла;

	        // Если записи нет — добавляем
	        Если Не ЗаписьНайдена Тогда
	            НоваяЗапись = НаборЗаписей.Добавить();
	            НоваяЗапись.Период = ТекущаяДата;
	            НоваяЗапись.Валюта = СсылкаВалюта;
	            НоваяЗапись.Курс = ДанныеКурса.Курс;
	            НоваяЗапись.Кратность = ДанныеКурса.Кратность;
		        КолНовыхЗаписей = КолНовыхЗаписей + 1;
	        КонецЕсли;

	        НаборЗаписей.Записать();
	    КонецЦикла;

	    ТекущаяДата = ТекущаяДата + 86400;
	КонецЦикла;

	Если КолНовыхЗаписей + КолОбнЗаписей > 0 Тогда
	    ВывестиСообщениеПользователю("Загрузка завершена. Записано в регистр ""Курсы валют"" новых: " + КолНовыхЗаписей + ". Обновлено: " + КолОбнЗаписей);
	Иначе
	    ВывестиСообщениеПользователю("Записи в регистр ""Курсы валют"" за указанные даты отсутствуют");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиСообщениеПользователю(Текст)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОткрытьРегистр(Параметр1, Параметр2) Экспорт
	
	Оповестить("ОбновитьКурсыВалют");
	ОткрытьФорму("РегистрСведений.КурсыВалют.ФормаСписка");
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодЗавершение(РезультатВыбора, ДопПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(Объект, РезультатВыбора, "ДатаНач,ДатаКон");
	
КонецПроцедуры

#КонецОбласти


