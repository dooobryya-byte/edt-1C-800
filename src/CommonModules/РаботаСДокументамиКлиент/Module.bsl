
#Область ПрограммныйИнтерфейс

// Задает пользователю вопрос о подтверждении действия.
// Вопрос задается немодально: процедура не ожидает ответа пользователя.
// Отказ всегда устанавливается в Истина, а действие выполняется в ОбработчикПродолжения
// только после утвердительного ответа.
//
// Параметры:
//   Отказ - Булево - устанавливается в Истина.
//   ОбработчикПродолжения - ОписаниеОповещения - что выполнить при ответе "Да".
//
Процедура ЗадатьВопросПользователю(Отказ, ОбработчикПродолжения = Неопределено) Экспорт
	
	Отказ = Истина;
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения(
		"ПослеВопросаПользователю", РаботаСДокументамиКлиент, ОбработчикПродолжения);
	
	ПоказатьВопрос(
		ОписаниеОповещенияОЗавершении,
		"Вы уверены, что хотите выполнить это действие?
		|При выполнении могут быть безвозвратно утеряны данные!",
		РежимДиалогаВопрос.ДаНет,
		10,
		КодВозвратаДиалога.Нет,
		"Внимание!");
	
КонецПроцедуры

